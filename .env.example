VLLM_BACKEND_URL=http://localhost:8001/v1/chat/completions
LLAMA_BACKEND_URL=http://localhost:8002/v1/chat/completions
# Container addresses are independent of native Gateway localhost addresses.
COMPOSE_VLLM_BACKEND_URL=http://vllm:8001/v1/chat/completions
COMPOSE_LLAMA_BACKEND_URL=http://llama:8002/v1/chat/completions
TOKEN_THRESHOLD=512
BACKEND_MODE=vllm
REQUEST_TIMEOUT=60
VLLM_SERVED_MODEL=qwen
LLAMA_SERVED_MODEL=qwen2.5-7b-instruct-Q4_K_M
MODEL_DIR=/absolute/path/to/models
VLLM_MODEL_PATH=/models/Qwen2.5-7B-Instruct-AWQ-Int4
LLAMA_MODEL_PATH=/models/qwen2.5-7b-instruct-Q4_K_M.gguf
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=32768
LLAMA_GPU_LAYERS=99
GRAFANA_ADMIN_PASSWORD=change-me
NGINX_PORT=80
GATEWAY_PORT=8000
VLLM_PORT=8001
LLAMA_PORT=8002
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
